# ==========================================================================
#  hoja-ruta-offal — variables de entorno
# ==========================================================================

# --- Base de datos compartida (base controletiquetas) ---
# Mismas credenciales que las otras apps. El módulo crea (idempotente) el
# esquema/tabla transporte.HojasRuta y guarda ahí las respuestas.
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=1433
DB_ENCRYPT=true

# Crear el esquema/tabla automáticamente al arrancar (idempotente).
# OJO: si el entorno local apunta a la MISMA base de producción, esto crea la
# tabla en prod. Es create-if-not-exists de un esquema nuevo, así que es seguro.
DB_AUTO_INIT=true

# --- Desarrollo local (NUNCA en producción) ---
# Simula un login sin Easy Auth. El fallback SOLO se activa con este flag en true;
# sin él (y sin la cabecera de Easy Auth) la app devuelve 401. En Azure no cargar estas.
ALLOW_DEV_LOGIN=false
DEV_EMAIL=

# Exigir permiso 'transporte' en el padrón (acceso.Permisos) para entrar.
# Dejar en false hasta cargar la app 'transporte' en el padrón; luego true.
TRANSPORTE_REQUIRE_PERMISSION=false
